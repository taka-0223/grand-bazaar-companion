{
  "schema_version": 1,
  "meta": {
    "id": "tool_upgrades",
    "status": "audited_v1",
    "target_game_version": "1.5.0",
    "verified_on": "2026-10-09",
    "purpose": "道具の段階別強化・必要資材・風車のデータ。アプリに直接全件表示せず既知情報・ネタバレ境界で絞り込む。",
    "scope": "Upgradeable five tools. Other three base-only tools are referenced through legacy MASTER.entities.",
    "source_policy": "GameWithの日本語道具一覧・強化時間を主軸としAppMediaの素材表で照合。究極の基準加工時間はStratsWikiを利用。",
    "sources": {
      "gamewith_upgrades": "https://gamewith.jp/bokumono-grabaza/515066",
      "gamewith_tool_catalog": "https://gamewith.jp/bokumono-grabaza/515003",
      "gamewith_ultimate": "https://gamewith.jp/bokumono-grabaza/518735",
      "appmedia_tool_catalog": "https://appmedia.jp/bokumono_grabaza/79201388",
      "stratswiki_ultimate": "https://stratswiki.com/sos-gb/guides/ultimate-tools/",
      "stratswiki_tool_overview": "https://stratswiki.com/sos-gb/tools/"
    },
    "interpretation": {
      "output_quantity": 1,
      "base_processing_minutes": "風力や青のすてきによる短縮前の基準時間（究極はStratsWiki記載の5日）。",
      "inventory_tool": "加工には前段階の道具本体を1個使用する。加工中の道具は装備できない。",
      "material_join": "ref.domain + ref.id is a stable reference to an existing Master array, not a game-internal item ID.",
      "discovery_policy": "ユーザーが取得・確認した道具だけを起点とする。未知の強化段階を一覧に自動露出しない。"
    },
    "known_conflicts": [
      {
        "topic": "orichalcum_hatchet_iron",
        "status": "resolved",
        "selected": "鉄鉱石×99",
        "sources": "GameWith 道具一覧・AppMediaは鉄鉱石。GameWith 強化まとめ表の『鉱石×99』は曖昧表記。"
      },
      {
        "topic": "sickle_base_name",
        "status": "alias",
        "selected": "カマ",
        "sources": "GameWith・AppMediaはカマ。現行MASTER.entitiesの同IDは鎌。どちらも同一sickleとして扱う。"
      },
      {
        "topic": "ultimate_processing_time",
        "status": "probable",
        "selected": "5日＝7200分",
        "sources": "StratsWiki Ultimate Tools。GameWithの集計記事に時間なし。"
      },
      {
        "topic": "normal_upgrade_processing_time",
        "status": "confirmed_primary",
        "selected": "GameWith加工時間",
        "sources": "GameWith強化一覧。別攻略サイトに一部の時間差があるため風力条件の差も考慮して基準値として保持。"
      }
    ]
  },
